# ========================================
# Project Manager System - Docker 环境配置
# ========================================
# 复制此文件为 .env 并修改对应值

# 后端安全配置（必填）
SECRET_KEY=your-random-secret-key-here
ADMIN_PASSWORD=your-admin-password

# Agent 密码配置（格式：name:password:role）
# role 可选值：agent（默认，工人）、mate（大副/管理）
# 不指定 role 时默认为 agent
AGENT_PASSWORDS=trae:CHANGE-ME,hermes-agent:CHANGE-ME,first-mate:CHANGE-ME:mate

# 版本号（与根目录 VERSION 文件保持一致，docker-compose 引用此值）
APP_VERSION=0.15.0

# 对外端口
BACKEND_PORT=8000
FRONTEND_PORT=8080

# MCP Server (Streamable HTTP 模式 - 推荐)
MCP_TRANSPORT=streamable-http
MCP_PORT=9000
MCP_HOST=0.0.0.0

# MCP Mate Server (大副 - 管理审批角色)
MCP_MATE_PORT=9001
MATE_PASSWORD=CHANGE-ME

# 可选
# DATABASE_URL=sqlite+aiosqlite:///data/project_manager.db
# CORS_ORIGINS=http://localhost:8080,http://YOUR_HOST_IP:8080
# HOST_IP=192.168.x.x
# DEBUG=false
