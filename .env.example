# ========================================
# Metis PM - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ─── Required ──────────────────────────────────────────

# JWT signing key (random 32+ characters)
SECRET_KEY=your-random-secret-key-here-min-32-chars

# Admin password (bcrypt hash)
# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password'.encode(), bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash-here

# Agent passwords (JSON format)
# Format: '{"name": {"password_hash": "$2b$12$...", "role": "agent"}, ...}'
# Roles: agent (default), mate (manager), tester, registrar
AGENT_PASSWORDS_JSON={}

# Fernet encryption key (for server credentials)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Optional ──────────────────────────────────────────

# APP_VERSION=1.3.0
# DEBUG=true
# DATABASE_URL=sqlite+aiosqlite:///./metis_pm.db
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── AI Copilot (optional) ────────────────────────────
# Install: cd backend && uv sync --extra copilot
# PM_COPILOT_ENABLED=true
# PM_API_BASE_URL=https://api.openai.com/v1
# PM_API_KEY=sk-...
# PM_MODEL=gpt-4o

# ─── MCP Server ────────────────────────────────────────
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=9000
