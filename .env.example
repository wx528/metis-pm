# ========================================
# Project Manager System - Docker 环境配置
# ========================================
# 复制此文件为 .env 并修改对应值

# ─── 安全配置（必填）──────────────────────────────────
SECRET_KEY=your-random-secret-key-here
ADMIN_PASSWORD=your-admin-password

# Agent 密码配置（格式：name:password:role）
# role 可选值：agent（默认）、mate（大副/管理）、tester（测试者）、registrar（项目登记管理员）
AGENT_PASSWORDS=trae:CHANGE-ME,hermes-agent:CHANGE-ME,first-mate:CHANGE-ME:mate,qa-tester:CHANGE-ME:tester,registrar:CHANGE-ME:registrar

# ─── 版本与端口 ────────────────────────────────────────
APP_VERSION=1.3.0
BACKEND_PORT=8000
FRONTEND_PORT=8080
MCP_PORT=9000

# ─── MCP Server ────────────────────────────────────────
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0

# ─── 数据库 ────────────────────────────────────────────
# 默认 SQLite（Docker 内路径）
DATABASE_URL=sqlite+aiosqlite:////data/project_manager.db

# PostgreSQL 模式（取消注释并启用 docker-compose.yml 中的 postgres 服务）：
# DATABASE_URL=postgresql+psycopg://pm:CHANGE-ME@postgres:5432/pm
# POSTGRES_PASSWORD=CHANGE-ME

# ─── 可选 ──────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:8080,http://YOUR_HOST_IP:8080
# HOST_IP=192.168.x.x
# DEBUG=false
