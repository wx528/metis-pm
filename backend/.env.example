# Metis PM - Backend Configuration
# Copy to .env and fill in your values

# ─── Required ──────────────────────────────────────────

# JWT signing key (random 32+ characters)
SECRET_KEY=your-random-secret-key-here-min-32-chars

# Admin password (bcrypt hash)
# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password'.encode(), bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Agent passwords (JSON format)
# Example: {"trae": {"password_hash": "$2b$12$...", "role": "agent"}, "mate": {"password_hash": "$2b$12$...", "role": "mate"}}
AGENT_PASSWORDS_JSON=

# Fernet encryption key (for server credentials)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Optional ──────────────────────────────────────────

DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./metis_pm.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ─── AI Copilot (optional) ────────────────────────────
# Install: uv sync --extra copilot
# PM_COPILOT_ENABLED=false
# PM_API_BASE_URL=https://api.openai.com/v1
# PM_API_KEY=
# PM_MODEL=gpt-4o

# ─── A2A Agent-to-Agent (optional) ───────────────────
# A2A_ENABLED=false
# A2A_AGENTS=agent1:http://host1:8001,agent2:http://host2:8002
