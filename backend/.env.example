# Project Manager Backend Configuration
# Copy this file to .env and fill in your values

# ===== 必填 =====

# JWT 签名密钥（随机 32+ 字符）
SECRET_KEY=your-random-secret-key-here-min-32-chars

# 管理员登录密码
ADMIN_PASSWORD=your-secure-password

# Agent 密码（格式: agent_name:password, 逗号分隔）
# 每个使用 MCP 的 AI Agent 用自己的密码获取 JWT 身份
AGENT_PASSWORDS=cline:CHANGE-ME,buddy:CHANGE-ME

# Fernet 加密密钥（用于加密服务器凭据 password/ssh_key）
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===== 可选 =====

DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./project_manager.db

# CORS 允许的前端地址（逗号分隔）
# 本地开发: http://localhost:5173
# Docker 部署: http://localhost:8080,http://127.0.0.1:8080
# 内网部署: 额外添加 http://你的服务器IP:8080
CORS_ORIGINS=http://localhost:5173
